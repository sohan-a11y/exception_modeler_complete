# Streamlit Cloud Secrets Template
# Copy this to your Streamlit Cloud app settings → Secrets

# Demo Mode Configuration
DEMO_MODE = "true"
DEMO_EXPIRY_HOURS = "24"
DEMO_USERNAME = "client"
DEMO_PASSWORD = "your-secure-password-here"

# OpenRouter API (for AI-powered analysis)
# Get your FREE API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-your-api-key-here"

# Optional: Analytics tracking
# ANALYTICS_ENABLED = "true"
